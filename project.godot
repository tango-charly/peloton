; Engine configuration file.
; Godot 4.7.2 verrouillé — voir docs/COMPATIBILITY.md

config_version=5

[application]

config/name="PROJECT PELOTON"
config/description="Carrière cycliste solo pilotée au home trainer."
run/main_scene="res://scenes/boot/main.tscn"
config/features=PackedStringArray("4.7")
config/use_custom_user_dir=true
config/custom_user_dir_name="ProjectPeloton"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-sqlite/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
